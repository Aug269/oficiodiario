{
  "name": "oficio-diario-lecionario-reb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ofício Diário & Lecionário da Rede Episcopal Brasileira — PWA litúrgico com cálculo perpétuo do ano cristão (2026–2075).",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host=0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pdf:extract": "node scripts/extract-pdf.mjs",
    "build:lectionary": "npm run pdf:extract && node scripts/build-lectionary.mjs",
    "verify:table": "npm run pdf:extract && tsx scripts/verify-table.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
